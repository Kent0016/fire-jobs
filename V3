create table buildings (
  id bigint generated by default as identity primary key,
  building_name text not null,
  address text not null,
  site_contact text,
  contact_phone text,
  contact_email text,
  access_notes text,

  alarm_panel text,
  alarm_panel_location text,
  alarm_zones text,
  alarm_monitoring boolean default false,
  monthly_test_point text,

  sprinkler_system text,
  sprinkler_valve_location text,
  sprinkler_pump boolean default false,

  general_notes text,

  created_at timestamptz default now()
);

alter table buildings enable row level security;

create policy "Allow everyone to read buildings"
on buildings
for select
to anon
using (true);

create policy "Allow everyone to add buildings"
on buildings
for insert
to anon
with check (true);

create policy "Allow everyone to update buildings"
on buildings
for update
to anon
using (true)
with check (true);

alter publication supabase_realtime add table buildings;

alter table jobs
add column building_id bigint references buildings(id);

create index jobs_building_id_idx
on jobs(building_id);
